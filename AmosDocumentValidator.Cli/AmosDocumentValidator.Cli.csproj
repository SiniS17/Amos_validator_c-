    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmosDocumentValidator.Core\AmosDocumentValidator.Core.csproj" />
    <ProjectReference Include="..\AmosDocumentValidator.Infrastructure\AmosDocumentValidator.Infrastructure.csproj" />
    <ProjectReference Include="..\AmosDocumentValidator.Validation\AmosDocumentValidator.Validation.csproj" />
    <ProjectReference Include="..\AmosDocumentValidator.Shared\AmosDocumentValidator.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
